{
  "name": "qbot-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend TypeScript cua QBot (NestJS + Prisma).",
  "scripts": {
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "format": "prisma format",
    "validate": "prisma validate",
    "smoke": "node prisma/smoke.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register --env-file=../.env --env-file=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:admin": "node prisma/seed-admin.mjs",
    "test": "ADMIN_PASSWORD=${ADMIN_PASSWORD:-Admin123!} pnpm seed:admin && ./test-auth.sh && ./test-chat.sh && node prisma/smoke.mjs"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "packageManager": "pnpm@9.7.0"
}

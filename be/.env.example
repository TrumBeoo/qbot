# ============================================================
# be/.env.example  —  copy sang .env rồi điền giá trị thật
#     cp .env.example .env
# Mọi biến dưới đây đều được đọc bằng os.getenv() trong be/.
# ============================================================

# ---------- BẮT BUỘC ----------
# Groq API key, lấy tại https://console.groq.com/keys
# Thiếu key: RAG/rag_engine.py raise ValueError ngay khi khởi động.
GROQ_API_KEY=

# Ký JWT cho cả user (services/auth_service.py) và admin
# (services/admin_auth_service.py). KHÔNG để trống: cả hai file đều fallback
# về chuỗi hardcode 'your-secret-key-change-this' nằm công khai trong repo,
# ai cũng forge được token admin.
# Sinh giá trị mới: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- MONGODB (users, admins, chat history — store chính) ----------
# Không set thì pymongo mặc định về localhost:27017 rồi timeout.
# Database name là "chatbot_AI", hardcode trong MongoDB/db/__init__.py.
MONGO_URI=mongodb://localhost:27017/

# ---------- MYSQL (conversations, messages, images — legacy) ----------
# LUÔN set MYSQL_PASSWORD, kể cả khi rỗng. Các module trong be/ có default
# KHÔNG khớp nhau: app.py / MySQL/db/__init__.py / services/simple_image_service.py
# dùng "123456", còn MySQL/setup_mysql.py / config/hybrid_config.py /
# services/analytics_service.py / services/chatbot_service.py dùng "".
# Bỏ trống biến này là mỗi module connect bằng một password khác nhau.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbot

# ---------- SOCIAL LOGIN (tuỳ chọn) ----------
# Chỉ cần nếu dùng /api/auth/google-login và /api/auth/facebook-login.
# GOOGLE_CLIENT_ID phải trùng với VITE_GOOGLE_CLIENT_ID ở fe/ và Dashboard/.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# be/.env — CHI mot bien, cho lan chay tren host.
#     cp .env.example .env
#
# Prisma va `pnpm dev` doc file nay SAU root .env, nen no ghi de
# DATABASE_URL ve localhost. Trong container thi compose ghi de thanh
# @postgres:5432.
#
# Moi secret khac (JWT_SECRET, GROQ_*, ...) nam o root .env.
DATABASE_URL="postgresql://qbot:qbot@localhost:5432/qbot?schema=public"

# ============================================================
# .env o thu muc goc — CHI danh cho compose.yaml
#     cp .env.example .env
#
# File nay KHONG chua secret. Secret cua backend nam trong be/.env,
# compose doc truc tiep file do qua "env_file" nen khong phai nhan doi.
#
# Toan bo bien duoi day deu co gia tri mac dinh trong compose.yaml,
# nen khong tao file .env nay thi "docker compose up" van chay.
# ============================================================

# ---------- Postgres (san cho pha 02) ----------
POSTGRES_USER=qbot
POSTGRES_PASSWORD=qbot
POSTGRES_DB=qbot

# ---------- MySQL ----------
# PHAI khop MYSQL_PASSWORD va MYSQL_DATABASE trong be/.env, khong thi
# container mysql tao user voi password khac cai backend dung de ket noi.
MYSQL_PASSWORD=123456
MYSQL_DATABASE=chatbot

# ---------- Build arg cua frontend ----------
# Bien VITE_* duoc nhung vao bundle luc BUILD. Doi cac gia tri nay thi
# phai "docker compose build fe dashboard" lai, restart khong du.
# Chu y 2 ten bien khac nhau va Dashboard co /api o cuoi.
VITE_API_BASE_URL=http://localhost:5555
VITE_API_URL=http://localhost:5555/api

# Dung chung cho ca 3 service. De trong = tat dang nhap Google/Facebook.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=

# ---------- Uid cho container backend ----------
# Container be ghi vao bind mount be/vectorstore/ va be/static/images/.
# Uid trong container phai khop uid so huu file tren host, khong thi
# RAG chet voi loi Permission denied. Xem uid cua ban bang: id -u
DOCKER_UID=1000
DOCKER_GID=1000

# ---------- AI service (pha 03) ----------
# Token dung chung giua API TypeScript va AI service. AI service tu choi moi
# request neu bien nay trong. Sinh moi:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=

# .env duy nhat cho ca stack.  cp .env.example .env
#
# Compose truyen file nay cho legacy, be va ai. Flask chay tren host thi
# load_dotenv() tu di nguoc len tim thay no. be chay tren host thi
# `node --env-file=../.env` doc no.
#
# Truoc day secret nam o hai cho (be/.env va legacy/.env) nen de lech nhau.

# ---------- Groq (BAT BUOC) ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Tren 1000 la moi request RAG tra HTTP 429 tren free tier.
GROQ_MAX_TOKENS=800

# ---------- Ky JWT (BAT BUOC) ----------
# be (TypeScript) TU CHOI khoi dong neu thieu. legacy thi am tham dung chuoi
# hardcode nam trong repo - dung de trong.
# Sinh moi: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------- Token noi bo giua be va ai ----------
# ai TU CHOI moi request neu thieu (503).
AI_SERVICE_TOKEN=

# ---------- PostgreSQL (store dich) ----------
POSTGRES_USER=qbot
POSTGRES_PASSWORD=qbot
POSTGRES_DB=qbot

# ---------- MySQL + MongoDB (legacy Flask con dung) ----------
# MYSQL_PASSWORD phai set tuong minh: default trong code legacy khong khop
# nhau giua cac module ("123456" o 3 cho, "" o 4 cho).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=chatbot
MONGO_URI=mongodb://localhost:27017/

# ---------- Social login (tuy chon) ----------
# De trong = tat dang nhap Google/Facebook, phan con lai van chay.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Uid cho container ghi vao bind mount ----------
# Phai khop uid host, xem bang: id -u
DOCKER_UID=1000
DOCKER_GID=1000

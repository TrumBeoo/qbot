# ============================================================
# fe/.env.example  —  Chat UI (Vite, port 3000)
#     cp .env.example .env
# Vite chỉ expose biến có tiền tố VITE_. Đổi file này phải restart dev server.
# CẢNH BÁO: mọi biến VITE_* bị nhúng vào bundle và ai xem source cũng thấy.
# Không bao giờ để secret ở đây — chỉ client id / public key.
# ============================================================

# URL backend Flask. Bỏ trống cũng được: code fallback về
# http://localhost:5555 (api_chat.js, api_voice.js, chatHistoryService.js).
# Lưu ý: Dashboard/ dùng tên biến khác (VITE_API_URL) và có thêm /api ở cuối.
VITE_API_BASE_URL=http://localhost:5555

# ---------- SOCIAL LOGIN (tuỳ chọn) ----------
# Dùng bởi src/components/SocialLogin/SocialLoginButtons.jsx.
# VITE_GOOGLE_CLIENT_ID phải trùng GOOGLE_CLIENT_ID trong be/.env.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# ============================================================
# Dashboard/.env.example  —  Admin UI (Vite, port 5173)
#     cp .env.example .env
# Vite chỉ expose biến có tiền tố VITE_. Đổi file này phải restart dev server.
# CẢNH BÁO: mọi biến VITE_* bị nhúng vào bundle, không để secret ở đây.
# ============================================================

# URL backend. Tên biến là VITE_API_URL (KHÁC fe/ dùng VITE_API_BASE_URL)
# và giá trị PHẢI có /api ở cuối — src/services/api.js fallback về
# http://localhost:5000/api rồi ghép tiếp path vào sau.
VITE_API_URL=http://localhost:5000/api

# ---------- SOCIAL LOGIN (tuỳ chọn) ----------
# src/components/auth/GoogleLoginButton.jsx kiểm tra biến này và báo lỗi
# nếu thiếu. Phải trùng GOOGLE_CLIENT_ID trong be/.env.
VITE_GOOGLE_CLIENT_ID=

# src/utils/facebookSDK.js
VITE_FACEBOOK_APP_ID=
